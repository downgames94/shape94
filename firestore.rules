rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /users/{uid} {
      allow create: if owner(uid);
      allow read, update, delete: if owner(uid) || admin();
      match /private/{docId} {
        allow read, write: if owner(uid);
      }
    }
    // Nenhum usuário pode listar contas de terceiros; administradores usam credencial custom claim.
    match /{document=**} { allow read, write: if false; }
  }
}
